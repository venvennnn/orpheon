# LLM provider: openai | anthropic | gemini | mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. Falls back to GITHUB_TOKEN in Actions.
# Use a PAT if you track private repositories.
ORPHEON_GITHUB_TOKEN=

# Optional override for the GitHub API host.
GITHUB_API_URL=https://api.github.com
