---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { isExperiment, loadAllProjects } from "../lib/projects";

const experiments = loadAllProjects().filter(isExperiment);
---

<BaseLayout title="Experiments" description="Experimental or placeholder repositories.">
  <h1 class="text-3xl font-medium tracking-tight">Experiments</h1>
  <p class="mt-3 text-ink-soft">
    Repositories marked experimental — including empty or placeholder repos.
  </p>
  {
    experiments.length === 0 ? (
      <p class="mt-8 text-ink-soft">None flagged yet.</p>
    ) : (
      <div class="mt-8">
        {experiments.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    )
  }
</BaseLayout>
