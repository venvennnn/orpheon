---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { isExperiment, loadAllProjects } from "../lib/projects";

const experiments = loadAllProjects().filter(isExperiment);
---

<BaseLayout title="Experiments" description="Experimental repositories.">
  <h1 class="text-center text-xl font-medium">Experiments</h1>
  {
    experiments.length === 0 ? (
      <p class="mt-6 text-ink-soft">None flagged yet.</p>
    ) : (
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {experiments.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    )
  }
</BaseLayout>
