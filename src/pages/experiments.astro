---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { isExperiment, loadAllProjects } from "../lib/projects";

const experiments = loadAllProjects().filter(isExperiment);
---

<BaseLayout title="Experiments" description="Experimental work tracked by Orpheon.">
  <p class="kicker">Lab bench</p>
  <h1 class="mt-3 font-serif text-5xl tracking-tight">Experiments</h1>
  <p class="mt-4 max-w-xl text-lg text-ink-soft">
    Work marked experimental in project metadata or <code>.orpheon.yml</code>.
  </p>
  {
    experiments.length === 0 ? (
      <p class="mt-12 max-w-xl border border-dashed border-line p-8 text-ink-soft">
        Nothing is flagged as an experiment yet. Set <code>status: experimental</code> on a project and the next successful generation will land it here.
      </p>
    ) : (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {experiments.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    )
  }
</BaseLayout>
