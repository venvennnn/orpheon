---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { loadAllProjects } from "../../lib/projects";

const projects = loadAllProjects();
---

<BaseLayout title="Projects" description="Tracked engineering projects.">
  <h1 class="text-3xl font-medium tracking-tight">Projects</h1>
  <p class="mt-3 text-ink-soft">{projects.length} repositories on record.</p>
  <div class="mt-8">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</BaseLayout>
