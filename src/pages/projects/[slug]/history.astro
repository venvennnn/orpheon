---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectHeader from "../../../components/ProjectHeader.astro";
import { loadAllProjects, splitBuildLog, type Project } from "../../../lib/projects";
import { renderMarkdown } from "../../../lib/markdown";

export function getStaticPaths() {
  return loadAllProjects().map((project) => ({
    params: { slug: project.meta.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const entries = splitBuildLog(project.buildLog?.body || "");
---

<BaseLayout title={`${project.meta.name} · Build history`} description={project.meta.tagline}>
  <ProjectHeader project={project} />
  <h2 class="mt-8 text-xl font-medium">Build history</h2>
  <p class="mt-2 text-ink-soft">
    Oldest entries stay. New ones are appended.
  </p>
  <ol class="mt-10 space-y-10">
    {
      entries.map((entry) => (
        <li class="border-t border-line pt-6">
          <h3 class="text-sm text-ink-soft">{entry.date}</h3>
          <div class="prose prose-journal mt-3" set:html={renderMarkdown(entry.body)} />
        </li>
      ))
    }
  </ol>
  {
    project.buildLog?.meta && (
      <p class="mt-10 text-sm text-ink-soft">
        Generated by {String(project.buildLog.meta.generated_by || "orpheon")}
        {project.buildLog.meta.source_commit
          ? ` · ${String(project.buildLog.meta.source_commit).slice(0, 7)}`
          : ""}
      </p>
    )
  }
</BaseLayout>
