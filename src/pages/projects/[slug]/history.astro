---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectHeader from "../../../components/ProjectHeader.astro";
import { loadAllProjects, splitBuildLog, type Project } from "../../../lib/projects";
import { renderMarkdown } from "../../../lib/markdown";

export function getStaticPaths() {
  return loadAllProjects().map((project) => ({
    params: { slug: project.meta.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const entries = splitBuildLog(project.buildLog?.body || "");
---

<BaseLayout title={`${project.meta.name} · Build history`} description={project.meta.tagline}>
  <ProjectHeader project={project} />
  <p class="mt-10 kicker">Build history</p>
  <h2 class="mt-3 font-serif text-4xl tracking-tight">How did it evolve?</h2>
  <p class="mt-4 max-w-xl text-ink-soft">
    Oldest entries stay frozen. Orpheon only appends.
  </p>
  <ol class="mt-12 space-y-12">
    {
      entries.map((entry) => (
        <li class="border-t border-line pt-8">
          <h3 class="font-mono text-sm uppercase tracking-widest">{entry.date}</h3>
          <div class="prose prose-journal mt-4" set:html={renderMarkdown(entry.body)} />
        </li>
      ))
    }
  </ol>
  {
    project.buildLog?.meta && (
      <p class="mt-12 font-mono text-[11px] uppercase tracking-widest text-ink-soft">
        Generated by {String(project.buildLog.meta.generated_by || "orpheon")}
        {project.buildLog.meta.source_commit
          ? ` · ${String(project.buildLog.meta.source_commit).slice(0, 7)}`
          : ""}
      </p>
    )
  }
</BaseLayout>
