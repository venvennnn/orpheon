---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectHeader from "../../../components/ProjectHeader.astro";
import Prose from "../../../components/Prose.astro";
import { loadAllProjects, splitEvolutions, type Project } from "../../../lib/projects";
import { renderMarkdown } from "../../../lib/markdown";

export function getStaticPaths() {
  return loadAllProjects().map((project) => ({
    params: { slug: project.meta.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const evolutions = splitEvolutions(project.evolution?.body || "");
---

<BaseLayout title={`${project.meta.name} · Technical`} description={project.meta.tagline}>
  <ProjectHeader project={project} />
  <h2 class="mt-8 text-xl font-medium">Technical</h2>
  {
    project.technical ? (
      <Prose html={renderMarkdown(project.technical.body)} provenance={project.technical.meta} />
    ) : (
      <p class="mt-8 text-ink-soft">No technical record yet.</p>
    )
  }
  {
    project.architecture && (
      <section class="mt-16">
        <h3 class="mt-12 text-lg font-medium">Architecture</h3>
        <pre class="mermaid mt-4 border border-line p-4">{project.architecture}</pre>
      </section>
    )
  }
  {
    evolutions.length > 0 && (
      <section class="mt-16">
        <h3 class="mt-12 text-lg font-medium">How it evolved</h3>
        <div class="mt-6 space-y-8">
          {evolutions.map((entry) => (
            <div class="prose prose-journal" set:html={renderMarkdown(entry)} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
