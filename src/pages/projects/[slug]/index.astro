---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectHeader from "../../../components/ProjectHeader.astro";
import { loadAllProjects, splitBuildLog, splitEvolutions, type Project } from "../../../lib/projects";
import { renderMarkdown } from "../../../lib/markdown";
import { withBase } from "../../../lib/site";

export function getStaticPaths() {
  return loadAllProjects().map((project) => ({
    params: { slug: project.meta.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const latest = splitBuildLog(project.buildLog?.body || "").slice(0, 1)[0];
const evolution = splitEvolutions(project.evolution?.body || "").slice(-1)[0];
const depths = [
  ["Explain simply", "A short walkthrough of what it is and who it is for.", "eli15"],
  ["Technical", "Components, APIs, and how to run it.", "technical"],
  ["References", "What the repo used, and related reading.", "references"],
  ["History", "Append-only notes of how the work changed.", "history"],
];
---

<BaseLayout title={project.meta.name} description={project.meta.tagline || project.meta.description}>
  <ProjectHeader project={project} />

  <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      depths.map(([label, blurb, suffix]) => (
        <a
          class="flex h-full flex-col border border-line p-4 hover:border-ink"
          href={withBase(`projects/${project.meta.slug}/${suffix}`)}
        >
          <h2 class="text-base font-medium">{label}</h2>
          <p class="mt-2 flex-1 text-sm text-ink-soft">{blurb}</p>
        </a>
      ))
    }
  </div>

  {
    latest && (
      <section class="mt-12">
        <h2 class="text-sm text-ink-soft">Latest log</h2>
        <p class="mt-2 text-sm">{latest.date}</p>
        <div class="prose prose-journal mt-2 text-sm" set:html={renderMarkdown(latest.body)} />
      </section>
    )
  }

  {
    evolution && (
      <section class="mt-12">
        <h2 class="text-sm text-ink-soft">Evolution</h2>
        <div class="prose prose-journal mt-3" set:html={renderMarkdown(evolution)} />
      </section>
    )
  }
</BaseLayout>
