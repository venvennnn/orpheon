---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectHero from "../../../components/ProjectHero.astro";
import { loadAllProjects, splitTakeaways, type Project } from "../../../lib/projects";
import { renderMarkdown } from "../../../lib/markdown";

export function getStaticPaths() {
  return loadAllProjects().map((project) => ({
    params: { slug: project.meta.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const summary = splitTakeaways(project.summary?.body || "");
---

<BaseLayout title={project.meta.name} description={project.meta.tagline || project.meta.description}>
  <article class="project-page">
    <ProjectHero project={project} />

    {
      project.problem && (
        <section class="project-card">
          <h2>Problem</h2>
          <div class="prose prose-journal" set:html={renderMarkdown(project.problem.body)} />
        </section>
      )
    }

    {
      project.summary && (
        <section class="project-card">
          <h2>Summary</h2>
          {summary.intro && (
            <div class="prose prose-journal" set:html={renderMarkdown(summary.intro)} />
          )}
          {summary.takeaways.length > 0 && (
            <div class:list={["takeaways", summary.intro && "mt-8"]}>
              {summary.takeaways.map((item) => (
                <div class="takeaway">
                  <h3>{item.title}</h3>
                  <div class="prose prose-journal" set:html={renderMarkdown(item.body)} />
                </div>
              ))}
            </div>
          )}
        </section>
      )
    }

    {
      project.architecture && (
        <section>
          <h2 class="section-title">Architecture</h2>
          <div class="fig-container">
            <pre class="mermaid">{project.architecture}</pre>
          </div>
        </section>
      )
    }

    {
      project.results && (
        <section class="project-card">
          <h2>Results</h2>
          <div class="prose prose-journal" set:html={renderMarkdown(project.results.body)} />
        </section>
      )
    }

    {
      project.examples && (
        <section class="project-card">
          <h2>Examples</h2>
          <div class="prose prose-journal" set:html={renderMarkdown(project.examples.body)} />
        </section>
      )
    }
  </article>
</BaseLayout>
