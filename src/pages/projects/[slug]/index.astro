---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectHeader from "../../../components/ProjectHeader.astro";
import { loadAllProjects, splitBuildLog, splitEvolutions, type Project } from "../../../lib/projects";
import { renderMarkdown } from "../../../lib/markdown";
import { withBase } from "../../../lib/site";

export function getStaticPaths() {
  return loadAllProjects().map((project) => ({
    params: { slug: project.meta.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const latest = splitBuildLog(project.buildLog?.body || "").slice(0, 1)[0];
const evolution = splitEvolutions(project.evolution?.body || "").slice(-1)[0];
---

<BaseLayout title={project.meta.name} description={project.meta.tagline || project.meta.description}>
  <ProjectHeader project={project} />

  <p class="mt-8 max-w-xl leading-relaxed">
    {project.meta.description || project.meta.tagline}
  </p>

  <ul class="mt-8 space-y-2 text-sm">
    {
      [
        ["Explain simply", "eli15"],
        ["Technical", "technical"],
        ["References", "references"],
        ["History", "history"],
      ].map(([label, suffix]) => (
        <li>
          <a class="underline underline-offset-4" href={withBase(`projects/${project.meta.slug}/${suffix}`)}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>

  {
    latest && (
      <section class="mt-12">
        <h2 class="text-sm text-ink-soft">Latest log</h2>
        <p class="mt-2 text-sm">{latest.date}</p>
        <div class="prose prose-journal mt-2 text-sm" set:html={renderMarkdown(latest.body)} />
      </section>
    )
  }

  {
    project.architecture && (
      <section class="mt-12">
        <h2 class="text-sm text-ink-soft">Architecture</h2>
        <pre class="mermaid mt-4 border border-line p-4">{project.architecture}</pre>
      </section>
    )
  }

  {
    evolution && (
      <section class="mt-12">
        <h2 class="text-sm text-ink-soft">Evolution</h2>
        <div class="prose prose-journal mt-3" set:html={renderMarkdown(evolution)} />
      </section>
    )
  }
</BaseLayout>
