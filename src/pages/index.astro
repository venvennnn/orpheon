---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { loadAllProjects } from "../lib/projects";
import { site } from "../lib/site";

const projects = loadAllProjects();
---

<BaseLayout>
  <h1 class="text-3xl font-medium tracking-tight">{site.title}</h1>
  <p class="mt-3 text-ink-soft">
    {site.tagline}
  </p>
  <p class="mt-4 max-w-xl text-sm text-ink-soft">
    All public repositories on this account, except this site. Documentation updates only when you run the journal Action — not on a schedule, and not on every commit.
  </p>

  <section class="mt-12">
    <p class="text-sm text-ink-soft">{projects.length} projects</p>
    <div class="mt-2">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>
</BaseLayout>
