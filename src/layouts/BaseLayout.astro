---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-white text-ink antialiased">
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4" href="#content">Skip to content</a>
    <Header />
    <main id="content" class="mx-auto w-full max-w-3xl px-5 pb-24 pt-10 sm:px-6">
      <slot />
    </main>
    <Footer />
    <script>
      import { initMermaid } from "../scripts/mermaid";
      initMermaid();
    </script>
  </body>
</html>
