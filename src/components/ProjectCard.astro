---
import type { Project } from "../lib/projects";
import { withBase } from "../lib/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = withBase(`projects/${project.meta.slug}`);
---

<a
  href={href}
  class="flex min-h-36 items-center justify-center border border-line px-4 py-8 text-center hover:border-ink"
>
  <h2 class="text-lg font-medium tracking-tight">{project.meta.name}</h2>
</a>
