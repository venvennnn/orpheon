---
import type { Project } from "../lib/projects";
import { formatShortDate, withBase } from "../lib/site";

interface Props {
  project: Project;
  index: number;
}

const { project } = Astro.props;
const { meta } = project;
const href = withBase(`projects/${meta.slug}`);
---

<article class="border-b border-line py-6">
  <h2 class="text-lg font-medium">
    <a href={href} class="hover:underline">{meta.name}</a>
  </h2>
  <p class="mt-1 text-ink-soft">
    {meta.tagline || meta.description || "A tracked project."}
  </p>
  <p class="mt-2 text-sm text-ink-soft">
    {formatShortDate(meta.last_updated)}
    {meta.categories.length > 0 && ` · ${meta.categories.join(", ")}`}
  </p>
</article>
