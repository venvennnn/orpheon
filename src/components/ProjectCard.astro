---
import type { Project } from "../lib/projects";
import { withBase } from "../lib/site";

interface Props {
  project: Project;
  index?: number;
}

const { project } = Astro.props;
const { meta } = project;
const href = withBase(`projects/${meta.slug}`);
---

<a
  href={href}
  class="flex h-full flex-col border border-line p-4 hover:border-ink"
>
  <h2 class="text-base font-medium">{meta.name}</h2>
  <p class="mt-2 flex-1 text-sm text-ink-soft">
    {meta.tagline || meta.description || "A tracked project."}
  </p>
  {
    meta.categories.length > 0 && (
      <p class="mt-3 text-xs text-ink-soft">{meta.categories.join(" · ")}</p>
    )
  }
</a>
