---
interface Props {
  html: string;
  provenance?: Record<string, unknown> | null;
}

const { html, provenance } = Astro.props;
---

<div class="prose prose-journal mt-10" set:html={html} />
{
  provenance && (
    <p class="mt-10 text-sm text-ink-soft">
      Generated by {String(provenance.generated_by || "orpheon")}
      {provenance.generated_at ? ` · ${provenance.generated_at}` : ""}
      {provenance.source_commit ? ` · ${String(provenance.source_commit).slice(0, 7)}` : ""}
    </p>
  )
}
