---
import type { Project } from "../lib/projects";
import { githubUrl } from "../lib/projects";
import { formatShortDate, withBase } from "../lib/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { meta } = project;
---

<header class="border-b border-line pb-6">
  <p class="text-sm text-ink-soft">{meta.repository}</p>
  <h1 class="mt-2 text-3xl font-medium tracking-tight">{meta.name}</h1>
  {meta.tagline && <p class="mt-3 max-w-xl text-ink-soft">{meta.tagline}</p>}
  {
    meta.categories.length > 0 && (
      <p class="mt-3 text-sm text-ink-soft">{meta.categories.join(" · ")}</p>
    )
  }
  {
    project.architecture && (
      <section class="mt-6">
        <h2 class="text-sm text-ink-soft">Architecture</h2>
        <pre class="mermaid mt-3 overflow-x-auto border border-line p-4">{project.architecture}</pre>
      </section>
    )
  }
  <div class="mt-5 flex flex-wrap gap-4 text-sm">
    {
      meta.demo && (
        <a class="underline underline-offset-4" href={meta.demo} rel="noreferrer">
          Demo
        </a>
      )
    }
    <a class="underline underline-offset-4" href={githubUrl(project)} rel="noreferrer">
      GitHub
    </a>
  </div>
  <p class="mt-4 text-sm text-ink-soft">
    Updated {formatShortDate(meta.last_updated)}
  </p>
</header>

<nav class="mt-5 flex flex-wrap gap-x-4 gap-y-2 border-b border-line pb-3 text-sm">
  {
    [
      ["Overview", ""],
      ["Explain simply", "eli15"],
      ["Technical", "technical"],
      ["References", "references"],
      ["History", "history"],
    ].map(([label, suffix]) => {
      const href = withBase(`projects/${meta.slug}${suffix ? `/${suffix}` : ""}`);
      const current = Astro.url.pathname.replace(/\/$/, "");
      const target = href.replace(/\/$/, "");
      const isActive = current === target;
      return (
        <a class:list={["hover:underline", isActive ? "text-ink" : "text-ink-soft"]} href={href}>
          {label}
        </a>
      );
    })
  }
</nav>
