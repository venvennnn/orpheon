---
import { site, withBase } from "../lib/site";

const here = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: withBase("projects"), label: "Projects" },
  { href: withBase("experiments"), label: "Experiments" },
  { href: withBase("about"), label: "About" },
];

function active(href: string) {
  const normalized = href.replace(/\/$/, "");
  if (normalized.endsWith("/projects")) {
    return here === normalized || here.startsWith(`${normalized}/`);
  }
  return here === normalized;
}
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4 sm:px-8">
    <a href={withBase()} class="text-base font-medium">{site.title}</a>
    <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-soft">
      {
        links.map((link) => (
          <a class:list={["hover:text-ink", active(link.href) ? "text-ink" : ""]} href={link.href}>
            {link.label}
          </a>
        ))
      }
      <a class="hover:text-ink" href={site.github} rel="noreferrer">GitHub</a>
    </nav>
  </div>
</header>
